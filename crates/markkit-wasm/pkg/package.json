{
  "name": "@everruns/markkit-wasm",
  "version": "0.1.1",
  "description": "Extract clean Markdown from HTML, DOCX and spreadsheets in the browser and edge runtimes (WebAssembly). Includes an LLM agent tool.",
  "type": "module",
